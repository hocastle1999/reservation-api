# 이 파일을 .env로 복사한 뒤 실제 값을 채우세요. (.env는 git에 올라가지 않습니다)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reservation
DB_USER=reservation_app
DB_PASSWORD=change-me
# 원격 DB(Aiven 등)에 접속할 때만: CA 인증서 파일 경로. 지정하면 SSL로 접속하고 인증서를 검증한다.
# DB_SSL_CA=C:\path\to\ca.pem
# DB_SSL_VERIFY_IDENTITY=true

# JWT 서명 키. 아래 명령으로 무작위 값을 만들어 넣는다. (32바이트 이상)
#   .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 겹치는 예약을 막는 방식: lock(자원 행 락) 또는 slot(30분 칸 + 기본키 중복)
RESERVATION_STRATEGY=lock
